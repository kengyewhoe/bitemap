# Copy to .env.scraper (gitignored) and fill in. Local scraper only — DEV project.

# Your Instagram session cookie. In a logged-in Chrome:
#   DevTools > Application > Cookies > instagram.com > copy the `sessionid` value.
# Expires periodically; refresh when the scraper reports "require login".
IG_SESSIONID=

# DEV Supabase project (ntujoeyymyeawjngyjld). URL matches web/.env.local.
SUPABASE_URL=https://ntujoeyymyeawjngyjld.supabase.co
# DEV service-role key: Supabase dashboard > Project Settings > API > service_role.
# Secret — never commit, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
